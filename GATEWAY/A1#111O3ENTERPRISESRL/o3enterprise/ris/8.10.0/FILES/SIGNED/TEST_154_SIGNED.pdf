          <text>
            <paragraph>
              <caption>Prestazioni Eseguite</caption>
            </paragraph>
            <list>
                            <item ID="Prestazione-1">
                <table>
                  <thead>
                    <tr>
                      <th>Prestazione 1</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
